// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`type-member-get-set.ts format 1`] = `
====================================options=====================================
parsers: ["typescript"]
                                                      printWidth: 80 (default) |
=====================================input======================================
interface Foo1 {
  get foo(): string;
  set bar(v);
}

type Foo2 = {
  get foo(): string;
  set bar(v);
}

interface Foo3 {
  set bar(foo: string);
}

=====================================output=====================================
interface Foo1 {
  get foo(): string;
  set bar(v);
}

type Foo2 = {
  get foo(): string;
  set bar(v);
};

interface Foo3 {
  set bar(foo: string);
}

================================================================================
`;
